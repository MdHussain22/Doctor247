# Copy to .env and fill in
DATABASE_URL="postgresql://postgres:postgres@localhost:5432/mediconnect"
JWT_SECRET="replace-with-a-long-random-string"
PORT=5000
NODE_ENV=development
# Only needed if the frontend is hosted on a different domain
CLIENT_ORIGIN=

# First admin account (created by npm run seed or seed:admin)
ADMIN_EMAIL=admin@mediconnect.local
ADMIN_PASSWORD=ChangeMe@123

# mock = fake test payments, razorpay = real Razorpay (test or live keys)
PAYMENT_MODE=mock
RAZORPAY_KEY_ID=
RAZORPAY_KEY_SECRET=
RAZORPAY_WEBHOOK_SECRET=

SLOT_HOLD_MINUTES=10
REFUND_CUTOFF_HOURS=2
