# Copy to .env and fill in
DATABASE_URL="postgresql://postgres:postgres@localhost:5432/mediconnect"
# Generate a new random secret; never put real secrets in this example file.
JWT_SECRET="replace-with-a-long-random-secret"
PORT=5000
NODE_ENV=development
# Only needed if the frontend is hosted on a different domain
CLIENT_ORIGIN=

# First admin account (created by npm run seed or seed:admin)
ADMIN_EMAIL=admin@example.com
ADMIN_PASSWORD=replace-with-a-unique-strong-password

# mock = fake test payments, razorpay = real Razorpay (use test keys first)
PAYMENT_MODE=mock
RAZORPAY_KEY_ID=
RAZORPAY_KEY_SECRET=
RAZORPAY_WEBHOOK_SECRET=

# Optional booking confirmation email delivery via Resend
RESEND_API_KEY=
RESEND_FROM_EMAIL=

# Optional automatic Google Meet creation via Google Calendar API OAuth
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
GOOGLE_REFRESH_TOKEN=
GOOGLE_CALENDAR_ID=primary

SLOT_HOLD_MINUTES=10
REFUND_CUTOFF_HOURS=2
